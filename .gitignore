# Build and IDE
.gradle/
build/
out/
.idea/
*.iml
.vscode/
node_modules/
dist/
*.tsbuildinfo
.build-deps/
coverage/
__pycache__/
*.py[cod]

# Local planning, development reports and manual test documents.
# Keep only the public build guide; new internal docs stay private by default.
/docs/*
!/docs/development/
/docs/development/*
!/docs/development/fork-and-build.md
/datasets/
/scripts/build_large_test_corpus.py
/scripts/build_synthetic_manifest.py
/scripts/generate_synthetic_pdfs.py
/scripts/validate_datasets.py
/scripts/validate_large_test_corpus.py

# Local agent/editor state
/.agents/
/.codex/

# Windows installer runtime (generated by scripts/stage-windows-runtime.ps1)
frontend/src-tauri/runtime/*
!frontend/src-tauri/runtime/README.md
frontend/src-tauri/.runtime-stage-*/
frontend/src-tauri/.runtime-previous-*/

# Local secrets and overrides
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
database-password
secrets/

# PrivateKB runtime data (never commit source or derived content)
/data/
/storage/
/uploads/
/extracted/
/chunks/
/cache/
/logs/
/tmp/

# Release downloads belong in Releases, not the source tree.
*-setup.exe
*-setup.exe.sha256
*-setup.exe.build.json
*.log

# OS
.DS_Store
Thumbs.db
